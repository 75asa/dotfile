# === peco ===
function ghq-peco() {
  local dir
  dir=$(ghq list -p | peco)
  if [ -n "$dir" ]; then
    cd "$dir"
  fi
}
zle -N ghq-peco
bindkey '^X' ghq-peco

function history-peco() {
  local cmd
  cmd=$(history | awk '{$1=""; print $0}' | tail -r | peco | sed 's/^ //')
  if [ -n "$cmd" ]; then
    BUFFER=$cmd
    zle redisplay
  fi
}
zle -N history-peco
bindkey '^R' history-peco

function file-peco() {
  local file
  file=$(fd --type f | peco)
  if [ -n "$file" ]; then
    BUFFER="$file"
    zle redisplay
  fi
}
zle -N file-peco
bindkey '^D' file-peco


# Gitブランチをプロンプトに表示
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats ' (%b)'
setopt PROMPT_SUBST
PROMPT='%F{green}%~%F{yellow}${vcs_info_msg_0_}%f $ '


